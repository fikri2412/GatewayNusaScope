{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=OperatorAi;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Storage": {
    "RootPath": "C:\\TempatAI\\ChatBot\\storage"
  },
  "Api": {
    "BaseUrl": "http://localhost:5080"
  },
  "Web": {
    "BaseUrl": "http://localhost:5175"
  },
  "Ai": {
    "Provider": "OpenAiCompatible",
    "BaseUrl": "https://localhost:44387/v1/",
    "MessagesPath": "chat/completions"
  },
  "Operator": {
    "MaxToolLoops": 5,
    "MaxHistoryMessages": 40,
    "MaxTokensPerConversation": 200000
  },
  "Auth": {
    "TokenMinutes": 480
  },
  "Dispatcher": {
    "MaxConcurrentOperators": 4,
    "MaxConcurrentSpecialists": 2,
    "SweepSeconds": 5,
    "OperatorDll": "..\\OperatorAi.Worker.Operator\\bin\\Debug\\net9.0\\OperatorAi.Worker.Operator.dll",
    "SpecialistDll": "..\\OperatorAi.Worker.Specialist\\bin\\Debug\\net9.0\\OperatorAi.Worker.Specialist.dll"
  },
  "Settings": {
    "RefreshSeconds": 15
  },
  "Queue": {
    "MaxRetries": 3,
    "StaleLockMinutes": 10
  },
  "Upload": {
    "MaxBytes": 10485760,
    "AllowedExtensions": [ ".xlsx", ".csv", ".pdf", ".png", ".jpg", ".jpeg", ".webp" ]
  }
}
